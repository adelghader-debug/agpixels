{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agpixels",
  "compatibility_date": "2026-04-26",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
